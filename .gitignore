# =========================
# Prisma
# =========================
generated/
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# =========================
# PostgreSQL Dumps / Backups
# =========================
*.sql
*.dump
# ...but Prisma migrations ARE source. Without them `prisma migrate deploy`
# has nothing to apply and a deployed DB silently never gets schema changes.
!backend/prisma/migrations/**/*.sql

# =========================
# Sessions / Temp Files
# =========================
sessions/
tmp/
temp/

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# Editor / IDE
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# ESLint Cache
# =========================
.eslintcache

# =========================
# Prettier
# =========================
.prettier-cache

# =========================
# Runtime Files
# =========================
pids
*.pid
*.seed
*.pid.lock

# =========================
# Optional npm cache
# =========================
.npm/

# =========================
# Parcel / Turbo / Next
# =========================
.cache/
.turbo/

# =========================
# Mac/Linux hidden files
# =========================
.*
!.gitignore
!.env.example
!.prettierrc
!.eslintrc
# Build inputs, not local config. Without these negations the blanket `.*` above
# keeps them out of the repository — and a clone that is missing .dockerignore
# builds an image with a Windows node_modules pasted over the Linux one.
!.dockerignore
!.gcloudignore
# Which Firebase project `firebase deploy` targets. Not a secret, and a clone
# without it deploys to whatever project happens to be selected — or nothing.
!.firebaserc
# The only thing making backend/hosting/public exist. Git cannot track an empty
# directory, and firebase deploy fails outright if the public folder is missing —
# so without this negation a fresh clone cannot deploy Hosting at all. It stays a
# DOTFILE deliberately: firebase.json ignores `**/.*`, so it is never uploaded,
# where any normal filename would be served and would shadow that path's rewrite.
!.gitkeep
# =========================
# Dev screenshots
# =========================
screenshots/

# design-sync (claude.ai/design import)
# The repo-wide '.*' rule above would swallow .design-sync/, whose config,
# notes, conventions and authored previews are meant to be committed.
!.design-sync/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.ds-sync/
ds-bundle/

# =========================
# Agent / AI tooling
# =========================
# .claude/, .agents/, .cursor/ etc. are already caught by the '.*' rule above.
# These are the non-dotted leftovers: skill installs write a lockfile and an
# empty root package-lock.json, neither of which describes this app's deps.
/skills-lock.json
/package-lock.json

# Screenshot/preview harness the design workflow drops in the repo root.
/serve.mjs
/screenshot.mjs
temporary screenshots/

# Design notes written up after a piece of work: what was built, which
# alternatives were rejected and why. Useful to read back, but they are a
# NARRATIVE ABOUT the code rather than an input to it — the reasons that have to
# survive are already in the comments beside the thing they explain, which is
# where somebody changing that line will actually look. Kept out of the repo so
# there is no second copy to go stale against the first.
#
# The durable planning record stays tracked: ROADMAP.txt, CONTEXT.md, COSTS.md,
# System-Design.txt.
/decisions/

# Throwaway scripts run against the database or the API to check something once
# — row counts before a migration, a backfill's output afterwards. Written to be
# deleted; this catches the ones that outlive the check.
/_*.mjs
/_*.js

# =========================
# Owner fare-zone editor
# =========================
# Built by tools/build-owner-editor.mjs from zone-editor.html + zones.geojson.
# Not committed on purpose: it is a copy of the rate card, and a committed copy
# is one somebody sends after it has gone stale. Rebuild before every send.
/tools/rcs-fare-zones.html
