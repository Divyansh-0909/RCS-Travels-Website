VITE_CLERK_PUBLISHABLE_KEY=
# Optional local-runner override; must match the backend development publishable key.
VITE_DEVELOPMENT_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=
# Optional local-runner override. When omitted, local development intentionally
# reuses VITE_GOOGLE_MAPS_API_KEY above so Maps matches production.
VITE_DEVELOPMENT_GOOGLE_MAPS_API_KEY=
# Public JavaScript Map ID associated with the same light and dark cloud styles
# as the RCS Captains Android Map ID. Map IDs are platform-specific.
VITE_GOOGLE_MAPS_MAP_ID=
