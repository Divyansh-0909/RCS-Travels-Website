{
  "name": "rcs-travels-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "theme": "node ../shared/theme/build-css.cjs",
    "predev": "npm run theme",
    "dev": "vite",
    "prebuild": "npm run theme",
    "build": "vite build",
    "test": "node --test \"tests/*.test.js\"",
    "preview": "vite preview",
    "storybook": "storybook dev --config-dir storybook --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "storybook:build": "storybook build --config-dir storybook --output-dir ../output/handoff/storybook --disable-telemetry",
    "test:ui": "playwright test --config tests/ui-quality/playwright.config.mjs",
    "chromatic": "chromatic --config-file chromatic.config.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
