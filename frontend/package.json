  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/clerk-js": "^5.128.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
