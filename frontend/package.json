    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "8.21.3",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "i18next": "^24.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.5.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^6.28.2",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
