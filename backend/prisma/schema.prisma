model Booking {
  id                          String                      @id @default(uuid())
  // The ride's human-readable name, "RCS4831902" — what a rider reads down a
  // phone line and what support searches on. `id` stays the key everything joins
  // on; this is never a foreign key, only ever a lookup and a display value.
  //
  // Not to be confused with User.bookingCode above, which is a different thing on
  // a different table: that one is per-ACCOUNT, stable for life, and doubles as
  // the OTP the driver checks before starting a ride (routes/driver.ts). This one
  // is per-RIDE and identifies nothing about the person.
  //
  // No @default — Prisma cannot express the generator, so lib/bookingReference.js
  // owns allocation and the collision retry, and createBooking() there is the only
  // supported way to insert a row here.
  reference                   String                      @unique
  userId                      String                      @map("user_id")
  driverId                    String?                     @map("driver_id")
  customerPhone               String                      @map("customer_phone")
  pickupAddress               String                      @map("pickup_address")
  pickupLat                   Float                       @map("pickup_lat")
  pickupLng                   Float                       @map("pickup_lng")
  dropAddress                 String                      @map("drop_address")
  dropLat                     Float                       @map("drop_lat")
  dropLng                     Float                       @map("drop_lng")
  vehicleClass                VehicleClass                @map("vehicle_class")
  // THE CAR THAT ACTUALLY CAME, snapshotted when a driver claims the ride.
  //
  // Not read through `driver` on demand, because a captain owns several cars and
  // switches between them: a live read makes every ride in a rider's history
  // retroactively show whichever car the man is sitting in today. A rider
  // disputing "the car that picked me up was DL01AB1234" is disputing this
  // column, and it has to still say what it said on the day.
  //
  // Nullable because a booking exists long before anybody is assigned to it, and
  // null forever on the rides that never found a driver.
  vehicleNumber               String?                     @map("vehicle_number")
  // The name of that car, "Maruti Swift Dzire", snapshotted in the same write
  // for the same reason: a rider's receipt shows the plate and the model side by
  // side, and read live through the relation the model would drift onto whatever
  // the captain drives today while the plate beside it stayed put. The two would
  // then be describing different cars — worse than showing neither.
  //
  // Nullable for the same two reasons as the plate — no assignment yet, and the
  // rides that never found a driver — plus one more it does not share: the cars
  // added before naming became required (vehicleInputSchema in types.ts) have a
  // null Driver.vehicleModel and so nothing to snapshot. Readers fall back to
  // the booked class rather than to the driver row; see the status endpoint in
  // routes/bookings.js for why the plate's fallback cannot be copied here.
  vehicleModel                String?                     @map("vehicle_model")
  // "Follow my ride" — an opaque handle that lets someone with the link watch
  // this trip WITHOUT an account. Minted only when the rider asks for it, so a
  // ride nobody shared has no live handle to leak, and cleared when he revokes.
  //
  // NOT the booking id. That id is already in the rider's own URL, is handed to
  // support, and appears in the WhatsApp templates — a share link built on it
  // could not be revoked without breaking all of those, and anyone who had ever
  // seen one would hold a permanent key to the ride.
  //
  // Nothing else may be looked up by this column, and nothing it feeds may be
  // written: see routes/share.js for the exact payload, which is deliberately
  // narrower than the rider's own status endpoint.
  shareToken                  String?                     @unique @map("share_token")
  // Every share dies on a clock, because the alternative is a link a rider sent
  // to one person in one moment that still answers a year later, in a group chat
  // he has left. Set at mint; the public route treats a past date as no link at
  // all rather than as a link to nothing.
  shareExpiresAt              DateTime?                   @map("share_expires_at")
  scheduledAt                 DateTime?                   @map("scheduled_at")
  isOutstation                Boolean                     @default(false) @map("is_outstation")
  preferSafeRoute             Boolean                     @default(false) @map("prefer_safe_route")
  safeWaypointLat             Float?                      @map("safe_waypoint_lat")
  safeWaypointLng             Float?                      @map("safe_waypoint_lng")
  needsCarrier                Boolean                     @default(false) @map("needs_carrier")
  distanceKm                  Float?                      @map("distance_km")
  fare                        Float                       @map("fare")
  // `fare` minus the pass-through charges (toll, parking, airport access, roof
  // carrier). Commission is a percentage of THIS, so storing it makes the cut
  // auditable from the row alone — and fare - rideFare recovers the add-ons.
  rideFare                    Float?                      @map("ride_fare")
  couponAmount                Float                       @default(0) @map("coupon_amount")
  customerPayment             Float                       @default(0) @map("customer_payment")
  scheduledAdvancePct         Int                         @default(0) @map("scheduled_advance_pct")
  scheduledAdvanceAmount      Int                         @default(0) @map("scheduled_advance_amount")
  scheduledAdvancePaidAmount  Int                         @default(0) @map("scheduled_advance_paid_amount")
  scheduledRemainingAmount    Int                         @default(0) @map("scheduled_remaining_amount")
  scheduledFinalPaidAmount    Int                         @default(0) @map("scheduled_final_paid_amount")
  scheduledFinalPaymentMethod PaymentMethod?              @map("scheduled_final_payment_method")
  scheduledFinalPaidAt        DateTime?                   @map("scheduled_final_paid_at")
  scheduledAdvanceDisposition ScheduledAdvanceDisposition @default(not_applicable) @map("scheduled_advance_disposition")
  rideNowPaidAmount           Int                         @default(0) @map("ride_now_paid_amount")
  rideNowPaymentMethod        PaymentMethod?              @map("ride_now_payment_method")
  rideNowPaidAt               DateTime?                   @map("ride_now_paid_at")
  // WHAT THIS RIDE COSTS IF NOBODY EVER SHARES IT — the solo price off the same
  // signed quote the shared price came from, set only on sharing bookings and
  // null on every solo one.
  //
  // Stored rather than recomputed, and it has to be. Re-pricing at completion
  // means a second Routes call against traffic that has moved since, so the
  // rider would be charged a number they were never shown. Deriving it from the
  // shared fare does not work either: the sharing price is rounded to the
  // nearest ₹10 (rideEstimate.js), so undoing the 25% does not land back on the
  // original — a ₹1000 solo and a ₹1010 solo both round to a ₹750 share.
  //
  // Read once, at completion, by the transition that settles the ride: a shared
  // booking that reaches `completed` with no shareGroupId was never joined, and
  // is re-priced to this. See the fare-switch block in routes/driver.ts.
  soloFare                    Float?                      @map("solo_fare")
  commissionPct               Float                       @default(0) @map("commission_pct")
  commissionAmt               Float                       @default(0) @map("commission_amt")
  status                      BookingStatus               @default(pending)
  // `status` is a current-state field: every transition overwrites the last, so once
  // a ride is cancelled or completed nothing records that it ever passed through
  // `reached`. That state is part of the evidence for deciding whether the scheduled
  // cancellation fee can apply (CHARGEABLE_STATUSES in routes/bookings.js), so the evidence for the charge is
  // destroyed by the transition that acts on it. These stamps are what a disputed
  // charge is defended with, and they cannot be backfilled — a column added later is
  // null for every ride taken before it existed.
  startedAt                   DateTime?                   @map("started_at")
  reachedAt                   DateTime?                   @map("reached_at")
  // How far the driver actually was from the pickup / drop when he marked arrival and
  // completion, in km, measured server-side against the position his app reported.
  // "The driver says he arrived" and "the driver was there" are different claims, and
  // only the second should be able to bill a rider.
  //
  // Nullable, like distanceKm: a booking is created long before either is known, so a
  // required column here would make every prisma.booking.create supply a distance for
  // a trip that has not happened. Null also covers a transition sent with no position,
  // which is the normal case when the OEM has killed the location service.
  reachedDistanceKm           Float?                      @map("reached_distance_km")
  reachedAccuracyM            Float?                      @map("reached_accuracy_m")
  reachedLocationAt           DateTime?                   @map("reached_location_at")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  completedAt                 DateTime?                   @map("completed_at")
  completedDistanceKm         Float?                      @map("completed_distance_km")
  completedAccuracyM          Float?                      @map("completed_accuracy_m")
  completedLocationAt         DateTime?                   @map("completed_location_at")
  completionOverrideReason    String?                     @map("completion_override_reason")
  completionCustomerConfirmed Boolean                     @default(false) @map("completion_customer_confirmed")
  confirmedAt                 DateTime?                   @map("confirmed_at")
  // Frozen when a driver accepts the assignment. Used for rider-facing late
  // detection so live navigation ETA changes cannot move the deadline.
  driverAssignedAt            DateTime?                   @map("driver_assigned_at")
  // The arrival time promised when the captain accepts. The delayed-pickup
  // grace period is measured from this frozen value, never from a moving live ETA.
  expectedPickupAt            DateTime?                   @map("expected_pickup_at")
  cancelledBy                 CancelledBy?                @map("cancelled_by")
  cancellationCharge          Float?                      @map("cancellation_charge")
  cancellationReason          String?                     @map("cancellation_reason")
  source                      BookingSource               @default(website)
  sharing                     Boolean                     @default(false)
  shareGroupId                String?                     @map("share_group_id")
  // THE STOP SEQUENCE OF A POOLED TRIP, and they are two numbers rather than one
  // because the orders genuinely differ: nearest-drop-first means the rider
  // collected first is often the one dropped second. `pickupOrder` alone cannot
  // say that, which is why it sat unwritten for as long as it was alone.
  //
  // Both are null on every solo ride and on a shared ride nobody has joined —
  // a lone rider has no sequence, only a trip. services/ridePooling.js is the
  // only thing that computes them, and driverAssignment writes them inside the
  // claim transaction so a half-ordered pool cannot exist.
  pickupOrder                 Int?                        @map("pickup_order")
  dropOrder                   Int?                        @map("drop_order")
  // How long Google said this trip would take when it was priced, in minutes.
  //
  // Already computed on every estimate (marketFare prices off it) and previously
  // thrown away, which left the tracking page estimating arrival in the browser
  // from a straight line. Null on bookings made before this column existed, and
  // on any whose quote predates it — treat a null as "unknown", never as zero.
  durationMin                 Int?                        @map("duration_min")
  // The encoded road path Google returned for this trip, as the polyline.
  //
  // Read by the pooling matcher: "is this new pickup ON the road this driver is
  // already driving" is a question about the path, not about bearings, and
  // geo.js can answer it directly from these vertices. Also already computed and
  // discarded before this column.
  routePolyline               String?                     @map("route_polyline")

  user   User    @relation(fields: [userId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  // Set once, the first time the T−1h "nobody has accepted" WhatsApp goes to
  // Raju. Without it the 5-minute sweep re-sends that message every 5 minutes
  // for the last hour — twelve identical messages, each one billed.
  adminAlertedAt         DateTime? @map("admin_alerted_at")
  // Claimed immediately before the T-30m template is sent. A failed send clears
  // its own claim so the five-minute sweep retries; overlapping sweeps cannot
  // both claim the same recipient.
  customerReminderSentAt DateTime? @map("customer_reminder_sent_at")
  driverReminderSentAt   DateTime? @map("driver_reminder_sent_at")

  review                                DriverReview?
  overchargeFlag                        OverchargeFlag?
  walletEntries                         WalletEntry[]
  coupon                                Coupon?
  payments                              Payment[]
  offers                                RideOffer[]
  driverCancellations                   DriverCancellation[]
  complaint                             RideComplaint?
  routeObservations                     RouteObservation[]
  cancellationLocationEvidence          CancellationLocationEvidence?
  responsibilityLiabilities             ResponsibilityLiability[]              @relation("ResponsibilityLiabilityBooking")
  responsibilityLiabilityEntries        ResponsibilityLiabilityEntry[]         @relation("ResponsibilityLiabilityEntryEarningBooking")
  responsibilityCompensationAllocations ResponsibilityCompensationAllocation[] @relation("ResponsibilityCompensationAllocationBooking")

  // Postgres does not index foreign keys automatically, and every index below is
  // driven by a real call site rather than by guesswork.
  //
  // my-bookings, recent-places and the account-download PDF all read one user's
  // rides newest-first; this serves the filter and the sort together, and covers
  // the user FK for parent deletes.
  @@index([userId, createdAt])
  // The two guards that run before any write: the "already have an active ride"
  // check on every create, and the live-ride check before account deletion.
  @@index([userId, status])
  // getDriver loads each candidate's live bookings to test the sharing corridor —
  // once per candidate, per radius ring. Also covers the driver FK.
  @@index([driverId, status])
  // assignScheduledRides polls this exact shape every 5 minutes, forever.
  @@index([status, scheduledAt])
  // Admin booking list: arbitrary filters, always sorted newest-first.
  @@index([createdAt])
  // Admin co-rider grouping fetches every booking sharing a group id.
  @@index([shareGroupId])
  @@map("bookings")
}

// The live fare-zone map, edited from the admin dashboard's Edit Fares tab and
// read by services/fareZones.js to price every ride.
//
// One row, always id 1, holding the whole GeoJSON FeatureCollection. The editor
// loads, edits and saves the entire collection in one go — a row per zone would
// turn every save into a full-table rewrite and buy no query we actually make,
// since matchZone tests a point against all zones anyway.
//
// backend/data/zones.geojson stays in git as the seed and the cold-start
// fallback, and it keeps writing through on every boot for as long as
// updated_by is still the seed marker — editing the file and restarting is the
// intended way to redraw zones before anyone has touched the dashboard. The
// first save from Edit Fares stamps a Clerk user id here and this row becomes
// the source of truth for good. See initFareZones().
model FareZoneSet {
  id        Int      @id @default(1)
  zones     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  // Clerk user id of the admin who saved it, so a bad rate card has an author.
  updatedBy String   @map("updated_by")

  @@map("fare_zone_set")
}

// Fixed NCR pricing — looked up by destination + vehicle class. Only the two
// base classes are ever stored; sedan and suv_premium are derived from their
// sibling in rideEstimate, so a destination needs no extra rows to gain them.
model FareTable {
  id              String       @id @default(uuid())
  destinationName String       @map("destination_name")
  vehicleClass    VehicleClass @map("vehicle_class")
  fixedFare       Float        @map("fixed_fare")
  isActive        Boolean      @default(true) @map("is_active")

  @@unique([destinationName, vehicleClass])
  @@map("fare_table")
}

// Tracks monthly usage of external APIs to enforce call limits
model ApiUsage {
  service String
  month   String // "YYYY-MM"
  count   Int    @default(0)

  @@id([service, month])
  @@map("api_usage")
}

// Whether forcing a given waypoint between two points yields a route clear of
// every shady zone. Cached because that answer depends on road topology and on
// the polygons — neither of which moves hour to hour — so it can be reused for
// weeks. The DISTANCE and DURATION of that route depend on traffic and are
// deliberately not stored: they are re-fetched whenever a fare is quoted on them.
//
// One row per route, overwritten rather than accumulated. `zonesVersion` is a
// hash of shady-zones.geojson; a row whose hash no longer matches is treated as
// a miss and re-checked, so redrawing a corridor invalidates the cache with no
// purge step.
model SafeRouteVerdict {
  routeKey     String   @id @map("route_key") // "lat,lng|lat,lng|waypointLat,waypointLng"
  zonesVersion String   @map("zones_version")
  clean        Boolean
  checkedAt    DateTime @default(now()) @map("checked_at")

  @@map("safe_route_verdicts")
}

// Temporary OTP store for WhatsApp OTP auth — one row per phone, upserted on each request
model OtpVerification {
  phone     String   @id
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@map("otp_verifications")
}

// Tracks in-progress WhatsApp booking bot conversations
model WhatsappSession {
  phone     String   @id
  step      String
  data      Json     @default("{}")
  language  String   @default("en")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_sessions")
}

// The vector type lives in extensions and is managed by reviewed SQL migrations.
// Required Unsupported fields use parameterized raw writes in the RAG repository.
model PolicyChunk {
  id             BigInt   @id @default(autoincrement())
  documentName   String   @map("document_name")
  section        String
  content        String
  sourcePath     String   @map("source_path")
  chunkKey       String   @map("chunk_key")
  contentHash    String   @map("content_hash")
  version        String
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  metadata       Json     @default("{}")
  embeddingModel String   @map("embedding_model")
  embedding      Unsupported("vector(1536)")

  @@unique([sourcePath, chunkKey])
  @@map("policy_chunks")
}
