generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BookingStatus {
  pending
  confirmed   // scheduled ride accepted, driver assigned closer to pickup time
  assigned
  en_route
  reached
  started
  completed
  cancelled
}

enum BookingSource {
  website
  whatsapp
  admin
}

enum CancelledBy {
  user
  driver
  admin
}

enum VerificationStatus {
  pending
  approved
  rejected
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  clerkId        String    @unique @map("clerk_id")
  phone          String    @unique
  name           String?
  // Stable 4-digit code generated once at signup. A user shows this same code to
  // the driver on every ride, so it lives on the user, not on each booking.
  bookingCode    String    @unique @map("booking_code")
  whatsappNumber String?   @map("whatsapp_number")
  createdAt      DateTime  @default(now()) @map("created_at")

  bookings Booking[]

  @@map("users")
}

model Driver {
  id            String      @id @default(uuid())
  clerkId       String?     @unique @map("clerk_id")
  name          String
  phone         String      @unique
  vehicleType   Int         @map("vehicle_type")
  vehicleCapacity     Int         @map("vehicle_capacity")
  vehicleNumber String         @map("vehicle_number")
  isActive      Boolean     @default(true) @map("is_active")
  isOnline      Boolean     @default(false) @map("is_online")
  fcmToken            String?            @map("fcm_token")
  dlDocUrl            String?            @map("dl_doc_url")
  aadharDocUrl        String?            @map("aadhar_doc_url")
  createdAt           DateTime           @default(now()) @map("created_at")
  verificationStatus  VerificationStatus @default(pending) @map("verification_status")

  location DriverLocation?
  bookings Booking[]

  @@map("drivers")
}

// One row per driver — upserted every 4 seconds when driver is online
// bearing + speedKmh enable dead reckoning on the client between polling intervals
model DriverLocation {
  driverId   String   @id @map("driver_id")
  latitude   Float
  longitude  Float
  bearing    Float?   // degrees 0–360, null until second update available
  speedKmh   Float?   // km/h, null until second update available
  updatedAt  DateTime @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_locations")
}

model Booking {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  driverId           String?       @map("driver_id")
  customerPhone      String        @map("customer_phone")
  pickupAddress      String        @map("pickup_address")
  pickupLat          Float         @map("pickup_lat")
  pickupLng          Float         @map("pickup_lng")
  dropAddress        String        @map("drop_address")
  dropLat            Float         @map("drop_lat")
  dropLng            Float         @map("drop_lng")
  vehicleType        Int           @map("vehicle_type")
  scheduledAt        DateTime?     @map("scheduled_at")
  isOutstation       Boolean       @default(false) @map("is_outstation")
  distanceKm         Float?        @map("distance_km")  
  fare               Float         @map("fare")
  commissionPct      Float         @default(0) @map("commission_pct")
  commissionAmt      Float         @default(0) @map("commission_amt")
  status             BookingStatus @default(pending)
  confirmedAt        DateTime?     @map("confirmed_at")
  cancelledBy        CancelledBy?  @map("cancelled_by")
  cancellationCharge Float?        @map("cancellation_charge")
  source             BookingSource @default(website)
  createdAt          DateTime      @default(now()) @map("created_at")
  completedAt        DateTime?     @map("completed_at")
  sharing            Boolean       @default(false)
  shareGroupId       String?       @map("share_group_id")
  pickupOrder        Int?          @map("pickup_order")

  user   User    @relation(fields: [userId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@map("bookings")
}

// Fixed NCR pricing — looked up by destination + vehicle type
model FareTable {
  id              String      @id @default(uuid())
  destinationName String      @map("destination_name")
  vehicleType     Int         @map("vehicle_type")
  fixedFare       Float       @map("fixed_fare")
  isActive        Boolean     @default(true) @map("is_active")

  @@unique([destinationName, vehicleType])
  @@map("fare_table")
}

// Tracks monthly usage of external APIs to enforce call limits
model ApiUsage {
  service String
  month   String  // "YYYY-MM"
  count   Int     @default(0)

  @@id([service, month])
  @@map("api_usage")
}

// Temporary OTP store for WhatsApp OTP auth — one row per phone, upserted on each request
model OtpVerification {
  phone     String   @id
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@map("otp_verifications")
}

// Tracks in-progress WhatsApp booking bot conversations
model WhatsappSession {
  phone     String   @id
  step      String
  data      Json     @default("{}")
  language  String   @default("en")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_sessions")
}
