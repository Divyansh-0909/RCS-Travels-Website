// One authoritative upheld Level-2 incident creates at most one immutable
// reliability strike. Historical cancellation/complaint records never populate
// this table; every row traces back to a FINAL_UPHELD responsibility decision.
model ReliabilityStrike {
  id                     String   @id @default(uuid())
  driverId               String   @map("driver_id")
  responsibilityCaseId   String   @unique @map("responsibility_case_id")
