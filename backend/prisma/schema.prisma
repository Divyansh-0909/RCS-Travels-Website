}

// Minimal Phase 6A finalization authorization record. The appeal/finalization
// workflow that creates this row is intentionally deferred; consequence code
// may only trust this persisted record together with ResponsibilityCase.state.
model ResponsibilityFinalDecision {
  id               String   @id @default(uuid())
  caseId           String   @unique @map("case_id")
  outcome          String
  classification   String?  @map("classification")
  consequenceLevel String   @map("consequence_level")
  evidenceHash     String   @map("evidence_hash")
  evidenceVersion  String?  @map("evidence_version")
  policyVersion    String   @map("policy_version")
  source           String   @default("PHASE6A_COMPAT")
  reason           String   @default("Finalized before Phase 6B lifecycle")
  actorId          String?  @map("actor_id")
  appealId         String?  @map("appeal_id")
  previousState    String?  @map("previous_state")
  finalizedAt      DateTime @map("finalized_at")
  createdAt        DateTime @default(now()) @map("created_at")

  case              ResponsibilityCase                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appeal            ResponsibilityAppeal?               @relation("ResponsibilityFinalDecisionAppeal", fields: [caseId, appealId], references: [caseId, id], onDelete: Restrict)
  execution         ResponsibilityConsequenceExecution?
