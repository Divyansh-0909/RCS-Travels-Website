PORT=5000
# App runtime connection (db/prisma.js). On Supabase use the SESSION POOLER URI —
# direct connections are IPv6-only on new projects, which neither Render's nor
# Cloud Run's egress reaches.
DATABASE_URL=
# Connections per process (db/prisma.js). Defaults to 5. This multiplies by the
# instance count, so it and Cloud Run's --max-instances have to move together:
# 5 x 4 instances = 20 sockets against the pooler. See backend/DEPLOY.md.
DATABASE_POOL_MAX=
# Used ONLY by prisma migrate / studio (see prisma.config.js). Supabase's
# "Direct connection" URI. Leave blank to fall back to DATABASE_URL.
DIRECT_URL=
# Comma-separated browser origins allowed to call this API, e.g.
# "https://rcstravels.vercel.app". Leave blank in dev — it defaults to the local
# Vite ports. Set this on Render or the deployed frontend will be blocked.
CORS_ORIGINS=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# The whole Firebase service account JSON, base64'd into one line. Get it from
# Firebase console -> Project settings -> Service accounts -> Generate new private
# key, then:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\key.json"))
# Base64 rather than separate projectId/clientEmail/privateKey vars because the
# private key is multi-line PEM — as its own var it needs a \n unescape that is
# easy to forget and only fails once deployed.
#   const sa = JSON.parse(Buffer.from(process.env.FIREBASE_SERVICE_ACCOUNT_BASE64, 'base64'))
FIREBASE_SERVICE_ACCOUNT_BASE64=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_MAPS_API_KEY=
# Signs the fare quotes /api/fare/estimate hands out and POST /api/bookings
# prices from. Any long random string (openssl rand -hex 32). REQUIRED in
# production — the server refuses to boot without it, because an unsigned quote
# means the client names its own fare. Dev generates a throwaway per process.
FARE_QUOTE_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Testing only: set to 1 to make the mock sendFCM accept the first driver instantly
# (skips the 30s wait + coin flip). Leave unset/0 in production.
FCM_ALWAYS_ACCEPT=0

# Supabase Storage — where driver documents live. The Project URL and the SECRET
# key from Project Settings -> API Keys ("sb_secret_..."; on the Legacy tab it is
# called "service_role"). This key bypasses RLS and reads every bucket, so it is
# server-only: it must never reach the captain app, the website, or a client
# bundle of any kind. The app only ever sees signed URLs this server mints.
# Production refuses to boot without both; dev answers 503 on the upload routes.
# After setting them, create the bucket once with: npm run storage:setup
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Background jobs -------------------------------------------------------
# How the three sweeps (dispatch, document-scan, document-expiry) are triggered.
#   interval  — in-process setInterval. The DEFAULT, and what Render uses. Leave
#               this blank anywhere the container runs continuously.
#   scheduler — the timers do not start; Cloud Scheduler POSTs the endpoints
#               instead. REQUIRED on Cloud Run with min-instances=0, where the
#               CPU is throttled between requests and a timer never fires.
# An unrecognised value refuses to boot rather than silently running nothing.
JOBS_MODE=
# The Cloud Run service URL Cloud Scheduler mints its OIDC token for, e.g.
# "https://rcs-api-abc123-el.a.run.app". Checked as the token's `aud`. Both this
# and the account below must be set in production or every internal call is
# refused with 503 — it fails closed on purpose.
INTERNAL_JOBS_AUDIENCE=
# The service account Cloud Scheduler runs as, e.g.
# "rcs-scheduler@rcs-travels.iam.gserviceaccount.com". Checked as the token's
# `email`, because a valid Google token only proves Google signed it.
INTERNAL_JOBS_SERVICE_ACCOUNT=
# DEVELOPMENT ONLY — a stand-in bearer token for curling /internal/jobs/:name on
# a laptop, where no OIDC token can be minted. Any long random string
# (openssl rand -hex 32). IGNORED when NODE_ENV=production, in code and not just
# by convention, so a copied .env cannot open production with it.
INTERNAL_JOBS_SECRET=
