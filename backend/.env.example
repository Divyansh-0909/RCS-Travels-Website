PORT=5000
# App runtime connection (db/prisma.js). On Supabase use the SESSION POOLER URI —
# direct connections are IPv6-only on new projects, which Render's egress may not reach.
DATABASE_URL=
# Used ONLY by prisma migrate / studio (see prisma.config.js). Supabase's
# "Direct connection" URI. Leave blank to fall back to DATABASE_URL.
DIRECT_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_MAPS_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Testing only: set to 1 to make the mock sendFCM accept the first driver instantly
# (skips the 30s wait + coin flip). Leave unset/0 in production.
FCM_ALWAYS_ACCEPT=0
