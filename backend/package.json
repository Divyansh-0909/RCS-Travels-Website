{
  "name": "rcs-travels-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-port.js",
    "dev": "node ../tools/dev/run.mjs backend",
    "predev:server": "node scripts/free-port.js",
    "dev:server": "tsx watch index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.js\"",
    "test:providers": "node --import tsx --test tests/providerFakes.test.js tests/providerFakes.edges.test.js",
    "test:db": "node tests/run-db-integration.js",
    "test:phase9": "node tests/run-phase9.js",
    "test:phase9:replay": "node tests/run-phase9.js --replay",
    "test:db:external": "node --import tsx --test \"tests/integration/*.test.js\"",
    "prestart": "node scripts/free-port.js",
    "start": "tsx index.js",
    "db:generate": "prisma generate --config ./prisma.config.js",
    "rag:check": "node --import tsx rcs-rag/src/scripts/loader.js --dry-run",
    "rag:load": "node --import tsx rcs-rag/src/scripts/loader.js",
    "rag:ask": "node --import tsx rcs-rag/src/scripts/ask-policy.ts",
    "rag:test": "node --import tsx --test tests/ragIngestion.test.js tests/ragAnswers.test.js",
    "db:migrate": "prisma migrate dev --config ./prisma.config.js",
    "db:deploy": "prisma migrate deploy --config ./prisma.config.js",
    "db:push": "prisma db push --config ./prisma.config.js",
    "db:studio": "prisma studio --config ./prisma.config.js",
    "db:seed": "node --import tsx prisma/seed.js",
    "db:seed:captain": "node --import tsx prisma/seed-captain.js",
    "db:seed:captain:rides": "node prisma/seed-captain-rides.js",
    "db:clean": "node prisma/clean-bookings.js",
    "db:clean:seed": "node prisma/clean-seed-data.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@clerk/express": "^1.3.21",
    "@google-cloud/storage": "^7.22.0",
    "@google-cloud/tasks": "^7.0.0",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "multer": "^2.1.1",
    "openai": "^7.10.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "uuid": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "12.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "nodemon": "^3.1.9",
    "prisma": "^7.8.0",
    "typescript": "^7.0.2"
  }
}
