{
  "name": "rcs-travels-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "start": "node index.js",
    "db:generate": "prisma generate --config ./prisma.config.js",
    "db:migrate": "prisma migrate dev --config ./prisma.config.js",
    "db:push": "prisma db push --config ./prisma.config.js",
    "db:studio": "prisma studio --config ./prisma.config.js",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@clerk/express": "^1.3.21",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.9",
    "prisma": "^7.8.0"
  }
}
