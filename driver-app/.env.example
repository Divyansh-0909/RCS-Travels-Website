# Used by deployed builds; the guarded local runner never trusts this value.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional local override. Otherwise the runner injects backend's validated test key.
EXPO_PUBLIC_DEVELOPMENT_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=
# Intentionally use the production Android Maps key and map ID in development.
GOOGLE_MAPS_ANDROID_API_KEY=
# Public Android Map ID with both light and dark cloud styles associated.
# MapSlot follows the device appearance and selects the matching style.
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
